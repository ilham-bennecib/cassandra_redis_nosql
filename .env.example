# Copier ce fichier en ".env" et remplir avec tes propres valeurs.
# Le vrai ".env" ne doit jamais être commité (il est dans .gitignore).

# Astra DB (Cassandra) - console Astra > ta base > Connect
ASTRA_DB_BUNDLE_PATH=secure-connect-tmdb-platform.zip
ASTRA_DB_APPLICATION_TOKEN=

# Redis Cloud - dashboard Redis Cloud > ta base > Configuration
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_USERNAME=default
